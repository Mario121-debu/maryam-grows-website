
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Discover Maryam Rahman — digital learning, creativity and personal growth.">
<title>Maryam Rahman | Digital & Creative Journey</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">

<style>
:root {
  --cream:#f6f3ec;
  --white:#fffefa;
  --black:#24231f;
  --muted:#77746d;
  --beige:#e8dfd0;
  --accent:#b79b79;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:var(--cream);
  color:var(--black);
  font-family:'DM Sans',sans-serif;
  line-height:1.7;
}
a{text-decoration:none;color:inherit}
nav{
  padding:22px 8%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  background:var(--cream);
  position:sticky;top:0;z-index:10;
  border-bottom:1px solid #e6e0d6;
}
.logo{font-family:'Playfair Display',serif;font-size:23px;font-weight:600}
.navlinks{display:flex;gap:25px;font-size:13px}
.navlinks a:hover{color:var(--accent)}
.menu{display:none;border:0;background:none;font-size:25px}
.hero{
  min-height:620px;
  padding:95px 10%;
  display:grid;
  grid-template-columns:1.2fr .8fr;
  align-items:center;
  gap:45px;
  overflow:hidden;
}
.eyebrow{
  font-size:11px;letter-spacing:3px;
  text-transform:uppercase;color:#92795c;
  font-weight:700;
}
h1{
  font-family:'Playfair Display',serif;
  font-size:clamp(48px,7vw,84px);
  line-height:1.12;
  font-weight:500;
  margin:22px 0;
}
h1 em{color:#a68b6c;font-weight:500}
.hero p{max-width:470px;color:var(--muted);font-size:15px}
.actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:30px}
.btn{
  padding:13px 23px;border-radius:3px;
  display:inline-block;font-size:13px;
  font-weight:600;transition:.25s;
}
.primary{background:var(--black);color:white}
.primary:hover{background:#74604a;transform:translateY(-3px)}
.secondary{border:1px solid #c7bdad}
.secondary:hover{background:var(--beige)}
.art{
  min-height:390px;background:var(--beige);
  position:relative;display:flex;
  justify-content:center;align-items:center;
  overflow:hidden;
}
.art:before{
  content:"";position:absolute;
  width:270px;height:270px;border-radius:50%;
  background:#d8c8b3;top:40px;right:-50px;
}
.art:after{
  content:"";position:absolute;
  width:220px;height:220px;border-radius:50%;
  border:1px solid #b8a58c;bottom:-80px;left:-35px;
}
.art-text{
  position:relative;z-index:1;
  text-align:center;font-family:'Playfair Display',serif;
  font-size:45px;line-height:1.2;
}
.art-text span{display:block;font-style:italic;color:#8b7356}
.art-small{
  position:absolute;bottom:20px;right:20px;
  z-index:2;font-size:10px;letter-spacing:2px;
}
section{padding:90px 10%}
.section-head{text-align:center;margin-bottom:45px}
h2{
  font-family:'Playfair Display',serif;
  font-size:clamp(34px,5vw,48px);
  font-weight:500;line-height:1.2;margin:12px 0;
}
.intro{
  max-width:680px;margin:auto;text-align:center;
  color:var(--muted);font-size:15px;
}
.about{background:var(--white)}
.cards{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:20px;margin-top:35px;
}
.card{
  padding:30px 25px;background:var(--white);
  border:1px solid #e9e3d9;transition:.3s;
}
.card:hover{transform:translateY(-7px);box-shadow:0 12px 35px #302b2010}
.number{font-size:12px;color:var(--accent);letter-spacing:2px}
.card h3{font-family:'Playfair Display',serif;font-size:23px;margin:15px 0}
.card p{font-size:13px;color:var(--muted)}
.journey{
  background:#eae4d9;text-align:center;
}
.quote{
  max-width:750px;margin:auto;
  font-family:'Playfair Display',serif;
  font-size:clamp(27px,4vw,42px);line-height:1.45;
}
.contact{text-align:center;background:var(--white)}
.contact p{color:var(--muted);max-width:520px;margin:15px auto 25px}
footer{
  padding:30px 8%;display:flex;
  justify-content:space-between;gap:15px;
  flex-wrap:wrap;font-size:12px;color:var(--muted);
}
.reveal{animation:appear .9s ease both}
@keyframes appear{
 from{opacity:0;transform:translateY(20px)}
 to{opacity:1;transform:translateY(0)}
}
@media(max-width:750px){
 nav{padding:18px 6%}
 .menu{display:block}
 .navlinks{
  display:none;position:absolute;top:65px;left:0;
  width:100%;background:var(--white);
  padding:25px;flex-direction:column;gap:18px;
 }
 .navlinks.open{display:flex}
 .hero{grid-template-columns:1fr;padding:75px 7%;gap:35px}
 .art{min-height:300px}
 section{padding:70px 7%}
 .cards{grid-template-columns:1fr}
 footer{flex-direction:column;text-align:center}
}
</style>
</head>

